{
  "name": "@slideforge/themes",
  "version": "0.1.0",
  "description": "SlideForge Built-in Themes",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./css/*": "./dist/css/*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && pnpm build:css",
    "build:css": "node scripts/build-css.js",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  },
  "license": "MIT"
}
