{
  "name": "@slideforge/mcp-server",
  "version": "0.1.0",
  "description": "SlideForge MCP Server - AI-First Slides Protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slideforge-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "pnpm type-check",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@slideforge/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "slideforge",
    "slides",
    "ai"
  ],
  "license": "Apache-2.0"
}
